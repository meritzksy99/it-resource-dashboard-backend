# ──────────────────────────────────────────────────────────────────────────
# 운영 배포용 환경변수 템플릿.
# 복사해서 실제 값 채운 뒤 `it-dash.env` 로 저장하고 `docker run --env-file it-dash.env` 로 주입.
# 실제 값 파일(*.env)은 절대 커밋 금지(.gitignore 로 제외됨).
# ──────────────────────────────────────────────────────────────────────────

# ── app DB (우리가 만든 HR/DASH 테이블이 있는 사내 Oracle) ──
APP_DB_URL=jdbc:oracle:thin:@APP_DB_HOST:1521/APP_SERVICE
APP_DB_USERNAME=appuser
APP_DB_PASSWORD=change-me
APP_DB_POOL_MAX=10

# ── legacy 기간계 (조회 전용) ──
LEGACY_DB_URL=jdbc:oracle:thin:@LEGACY_DB_HOST:1521/LEGACY_SERVICE
LEGACY_DB_USERNAME=legacyuser
LEGACY_DB_PASSWORD=change-me
LEGACY_DB_POOL_MAX=8

# ── 보안 시크릿 ──
JWT_SECRET=please-generate-a-32byte-random-secret
JWT_EXPIRATION=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-set-a-strong-password

# ── Flyway (app DB 스키마 마이그레이션) ──
#  기본 false = 이미 만들어 둔 스키마에 "붙기만" 함(마이그레이션 미실행, 권장).
#  빈 DB에 Flyway가 HR/DASH 테이블을 생성하게 하려면 true (앱 계정에 DDL 권한 필요).
FLYWAY_ENABLED=false

# ── 프로파일(이미지 기본값이 prod 라 보통 생략 가능) ──
SPRING_PROFILES_ACTIVE=prod
