# ============================================================================
# 배포용 환경변수 — 이 파일을 복사해서 it-dash.env 로 저장하고 실제 값 입력.
#   cp it-dash.env.example it-dash.env  &&  vi it-dash.env
# it-dash.env(실제 값)는 커밋/공유 금지.
# ============================================================================

# ── app DB : 우리가 만든 HR/DASH 테이블이 있는 사내 Oracle ──
#  (A) Easy Connect 방식(가장 간단)
APP_DB_URL=jdbc:oracle:thin:@APP_DB_HOST:1521/APP_SERVICE_NAME
#  (B) tnsnames 별칭 방식이면 → APP_DB_URL=jdbc:oracle:thin:@APP_ALIAS  (아래 ORACLE_NET_TNS_ADMIN 참고)
APP_DB_USERNAME=appuser
APP_DB_PASSWORD=CHANGE_ME
APP_DB_POOL_MAX=10

# ── legacy 기간계 : 조회 전용 ──
LEGACY_DB_URL=jdbc:oracle:thin:@LEGACY_DB_HOST:1521/LEGACY_SERVICE_NAME
LEGACY_DB_USERNAME=legacyuser
LEGACY_DB_PASSWORD=CHANGE_ME
LEGACY_DB_POOL_MAX=8

# ── (선택) tnsnames.ora 사용 시 : 파일 둔 폴더를 컨테이너에 마운트하고 경로 지정 ──
# ORACLE_NET_TNS_ADMIN=/tnsadmin

# ── 보안 시크릿 ──
JWT_SECRET=CHANGE_ME_32BYTE_RANDOM        # 예: openssl rand -base64 48
JWT_EXPIRATION=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG

# ── Flyway : 기본 꺼짐(이미 만든 스키마에 붙기만). 빈 DB 생성 필요할 때만 true ──
FLYWAY_ENABLED=false

# 프로파일은 이미지 기본값(prod)이라 보통 생략
# SPRING_PROFILES_ACTIVE=prod
